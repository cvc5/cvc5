; EXPECT: sat
(set-logic QF_UF)
(declare-sort U 0)
(declare-sort V 0)
(declare-fun a () U)
(declare-fun b () U)
(declare-fun p () V)
(declare-fun q () V)
(declare-fun f (V) U)
(declare-fun h (U) V)
(assert (or (= (f p) a) (= (f p) b)))
(assert (or (= (f q) a) (= (f q) b)))
(assert (or (= (h a) p) (= (h a) q)))
(assert (or (= (h b) p) (= (h b) q)))
(assert (not (= (f (h a)) a)))
(assert (not (= (f (h b)) b)))
(check-sat)
