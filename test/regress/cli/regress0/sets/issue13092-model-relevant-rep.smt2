(set-option :produce-models true)
(set-logic ALL)
(set-info :status sat)
(declare-sort Role 0)
(declare-const role Role)
(declare-fun roleAncRoles (Role) (Set Role))
(declare-sort User 0)
(declare-const principal User)
(declare-fun userAncUsers (User) (Set User))
(define-fun principalAncUsers () (Set User) (userAncUsers principal))
(declare-fun userAncRoles (User) (Set Role))
(declare-fun roleAncUsers (Role) (Set User))
(declare-sort Team 0)
(declare-const team1 Team)
(declare-const team2 Team)
(declare-const team3 Team)
(declare-fun teamAncUsers (Team) (Set User))
(assert (not (set.member role (roleAncRoles role))))
(assert (set.subset (roleAncUsers role) principalAncUsers))
(assert (not (set.member principal (roleAncUsers role))))
(assert (or (not (set.member principal (teamAncUsers team1))) (set.subset principalAncUsers (teamAncUsers team1))))
(assert (or (not (set.member principal (teamAncUsers team2))) (set.subset principalAncUsers (teamAncUsers team2))))
(assert (or (not (set.member principal (teamAncUsers team3))) (set.subset principalAncUsers (teamAncUsers team3))))
(assert (set.member role (userAncRoles principal)))
(check-sat)
