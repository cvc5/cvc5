; EXPECT: unsat
(set-logic UFLIA)
(declare-fun P (Int) Bool)
(declare-fun Q (Int) Bool)
(declare-fun R (Int Int) Bool)
(declare-fun S (Int Int) Bool)
(declare-fun T (Int Int) Bool)
(declare-fun U (Int Int) Bool)
(declare-fun b () Bool)
(assert (or b (forall ((i Int) (j Int))
  (or (P i) (Q j) (R i j) (S i j) (T i j) (U i j)))))
(assert (forall ((y Int) (x Int))
  (or (U x y) (T x y) (S x y) (R x y) (Q y) (P x))))
(assert (not (P 0)))
(assert (not (Q 1)))
(assert (not (R 0 1)))
(assert (not (S 0 1)))
(assert (not (T 0 1)))
(assert (not (U 0 1)))
(check-sat)
