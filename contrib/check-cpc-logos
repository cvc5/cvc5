#!/usr/bin/env bash
#
# Ask whether proofs/eo/cpc is still in sync with the Cpc package of the Logos
# commit pinned in contrib/get-cpc-compiler, which must have been run first.
#
# The work is done by Logos' own scripts/install-cpc.sh --check: it compiles
# this CPC signature with ethos-eoc, performs the whole install into a
# throwaway copy of the Cpc package, and compares. Nothing is written. Doing it
# that way rather than reimplementing the comparison here is what keeps the
# check from drifting from the install it is checking.
#
# There are two distinct outcomes to separate, because they are not equally
# actionable in a cvc5 pull request:
#
#   - the signature does not compile. This is a change to proofs/eo that the
#     Eunoia compiler cannot handle, and it is fixable in the pull request that
#     introduced it. Reported as an error (exit 1).
#
#   - the signature compiles, but the pinned Logos was generated from an older
#     CPC. This cannot be fixed in the cvc5 pull request: Logos has to be
#     regenerated first and LOGOS_VERSION moved afterwards. Reported as
#     out of date (exit 2), which the caller decides what to do with; pass
#     --strict to make it an error too.
#
# What --check does and does not see: it catches rules added to or removed from
# the calculus and any change to the signature-wide modules Logos generates. It
# does not catch an existing rule whose statement changed in a way that breaks
# its Lean proof, since install-cpc.sh preserves rule files. That failure is
# caught by building Logos, which happens in the Logos repository.
#
# Usage: contrib/check-cpc-logos [--strict] [--mini] [-- ARGS...]

set -e -o pipefail

STRICT=0
declare -a EXTRA_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --strict) STRICT=1; shift ;;
    --) shift; EXTRA_ARGS+=("$@"); break ;;
    -h|--help) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) EXTRA_ARGS+=("$1"); shift ;;
  esac
done

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
CVC_DIR="$(realpath "$SCRIPT_DIR/../")"
CPC_COMPILER_DIR="$CVC_DIR/deps/cpc-compiler"
SIGNATURE="$CVC_DIR/proofs/eo/cpc/Cpc.eo"

if [ ! -x "$CPC_COMPILER_DIR/scripts/install-cpc.sh" ]; then
  echo "error: $CPC_COMPILER_DIR is not set up. Run contrib/get-cpc-compiler first." >&2
  exit 1
fi
if [ ! -f "$CPC_COMPILER_DIR/deps/eoc-env.sh" ]; then
  echo "error: the Eunoia compiler was not built under $CPC_COMPILER_DIR/deps." >&2
  echo "Rerun contrib/get-cpc-compiler." >&2
  exit 1
fi

# eoc-env.sh records absolute paths, so a deps directory that was moved or
# restored under a different workspace still has the file while pointing
# nowhere. Say so here rather than letting it look like a compile failure.
EOC_ETHOS_DIR=""
# shellcheck source=/dev/null
source "$CPC_COMPILER_DIR/deps/eoc-env.sh"
if [ ! -f "$EOC_ETHOS_DIR/tools/eoc/driver.py" ]; then
  echo "error: $CPC_COMPILER_DIR/deps/eoc-env.sh points at $EOC_ETHOS_DIR, which is" >&2
  echo "not there. The directory was set up under a different path; rerun" >&2
  echo "contrib/get-cpc-compiler." >&2
  exit 1
fi
if [ ! -f "$SIGNATURE" ]; then
  echo "error: $SIGNATURE not found." >&2
  exit 1
fi

echo "=== Checking $SIGNATURE against Logos $(cat "$CPC_COMPILER_DIR/.cvc5-logos-version" 2>/dev/null || echo '<unknown>')"

# install-cpc.sh exits 1 both when the compile fails and when the package is
# merely out of date, so the two are told apart by the line it prints on the
# latter. Keeping the run's exit status requires pipefail, which is set above.
set +e
output="$("$CPC_COMPILER_DIR/scripts/install-cpc.sh" --signature "$SIGNATURE" --check \
          "${EXTRA_ARGS[@]}" 2>&1)"
status=$?
set -e

printf '%s\n' "$output"

if [ "$status" -eq 0 ]; then
  echo ""
  echo "proofs/eo/cpc is in sync with the pinned Logos."
  exit 0
fi

if ! printf '%s\n' "$output" | grep -q 'is NOT up to date with'; then
  echo "" >&2
  echo "error: the CPC signature did not compile with the Eunoia compiler that" >&2
  echo "Logos regenerates its Cpc package with. This is a change to proofs/eo" >&2
  echo "that the compiler cannot handle; the output above says where." >&2
  exit 1
fi

echo ""
echo "The CPC signature compiles, but the Cpc package of the pinned Logos was"
echo "generated from an older version of it. To resolve:"
echo ""
echo "  1. regenerate and repair Logos against this signature:"
echo "       <logos>/scripts/install-cpc.sh --signature $SIGNATURE"
echo "       <logos>/scripts/build.sh Cpc"
echo "  2. land that in ajreynol/logos"
echo "  3. move LOGOS_VERSION in contrib/get-cpc-compiler to the resulting commit"
echo ""

if [ "$STRICT" -eq 1 ]; then
  echo "error: proofs/eo/cpc is not in sync with the pinned Logos." >&2
  exit 1
fi

exit 2
