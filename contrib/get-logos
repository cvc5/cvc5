#!/usr/bin/env bash
#
# Download Logos (https://github.com/ajreynol/logos) at the commit pinned
# below and build the Eunoia compiler (ethos-eoc) that it regenerates its Cpc
# package with.
#
# Everything is placed under deps/logos, which is self-contained: Logos'
# scripts put their own ethos checkout under deps/logos/deps, pinned to a
# commit of their choosing that is deliberately *not* the one
# contrib/get-ethos-checker uses. The two must not be mixed; ethos-eoc reads
# its Lean and Eunoia templates out of the tree it was configured from, so a
# mixed run compiles with the wrong templates and still succeeds.
#
# After this, contrib/check-cpc-logos asks whether proofs/eo/cpc is still in
# sync with the Cpc package of the pinned Logos.

set -e -o pipefail

# utility function to download a file
function download {
  if [ -x "$(command -v wget)" ]; then
    wget -c -O "$2" "$1"
  elif [ -x "$(command -v curl)" ]; then
    curl -L "$1" >"$2"
  else
    echo "Can't figure out how to download from web.  Please install wget or curl." >&2
    exit 1
  fi
}

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
CVC_DIR="$(realpath "$SCRIPT_DIR/../")"
mkdir -p "$CVC_DIR/deps"
BASE_DIR="$CVC_DIR/deps"
mkdir -p "$BASE_DIR/tmp"

##### Logos
LOGOS_DIR="$BASE_DIR/logos"

# The pinned commit of ajreynol/logos that proofs/eo/cpc is checked against.
# Moving this pin is what records that Logos has been regenerated against a
# newer CPC; see contrib/check-cpc-logos and the workflow that runs it.
# c8b547b9 is "Installation scripts (#437)", the commit that added the
# install-cpc.sh --check this is built around.
LOGOS_VERSION="c8b547b92ad0f0736da7b87fc778f98bba0e2a5f"

rm -rf "$LOGOS_DIR"
mkdir -p "$LOGOS_DIR"
download "https://github.com/ajreynol/logos/archive/$LOGOS_VERSION.tar.gz" "$BASE_DIR/tmp/logos.tgz"
tar --strip 1 -xzf "$BASE_DIR/tmp/logos.tgz" -C "$LOGOS_DIR"
rm "$BASE_DIR/tmp/logos.tgz"
echo "$LOGOS_VERSION" > "$LOGOS_DIR/.cvc5-logos-version"

# Build ethos-eoc. This fetches the ethos commit that Logos pins in
# scripts/get-eo-compiler.sh and records the resulting paths in
# deps/logos/deps/eoc-env.sh, which install-cpc.sh reads. No cvc5 build and no
# cvc5 binary is involved: what the compiler consumes is Eunoia source text.
echo ""
echo "=== Building the Eunoia compiler that Logos regenerates Cpc with"
"$LOGOS_DIR/scripts/get-eo-compiler.sh"

echo ""
echo "========== How to use Logos =========="
echo "Check that proofs/eo/cpc is in sync with the pinned Logos:"
echo "  $CVC_DIR/contrib/check-cpc-logos"
echo "Regenerate the Cpc package of a Logos checkout from this CPC signature:"
echo "  <logos>/scripts/install-cpc.sh --signature $CVC_DIR/proofs/eo/cpc/Cpc.eo"
