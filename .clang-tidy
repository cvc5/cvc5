# The checks to run are listed explicitly, starting from -*, rather than
# relying on the checks that clang-tidy enables by default, since those depend
# on its version: clang-diagnostic-* and clang-analyzer-* up to clang-tidy 21,
# only clang-diagnostic-* from clang-tidy 22 on. See:
#   https://github.com/llvm/llvm-project/pull/157306
# NOTE:
#  We disable clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
#  since it produces non-actionable warnings. See:
#    https://github.com/llvm/llvm-project/issues/64027
Checks: >
  -*,
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  cvc5-*,
  modernize-deprecated-headers,
  modernize-use-nullptr
HeaderFilterRegex: '.*'
# Use .clang-format for formatting changes
FormatStyle: file
